{
  "manifest_version": 3,
  "name": "AccessAble",
  "version": "1.0.0",
  "description": "Screen reader and accessibility tool for web content",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://accessable-fyp.onrender.com/"
  ],
  "background": {
    "service_worker": "background/background-wrapper.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Toggle screen reader on/off"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Pause or resume reading"
    },
    "read-next": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Read next element"
    },
    "read-previous": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Read previous element"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}